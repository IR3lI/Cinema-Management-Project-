@model IEnumerable<Movie>
@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "_AdminLayout";
    var cinemas = ViewBag.Cinemas as List<Cinema> ?? new List<Cinema>();
    var selectedCinemaId = ViewBag.CinemaId as int?;
    var todayRevenue = (decimal)(ViewBag.TodayRevenue ?? 0m);
    var todayTicketRevenue = (decimal)(ViewBag.TodayTicketRevenue ?? 0m);
    var todayFnBRevenue = (decimal)(ViewBag.TodayFnBRevenue ?? 0m);
    var printedTickets = (int)(ViewBag.TotalPrintedTickets ?? 0);
    var occupancyRate = (decimal)(ViewBag.OccupancyRate ?? 0m);
}

<!-- Top Branch Filter & Welcome Bar -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard Quản Trị Hệ Thống Rạp Chiếu Phim
            </h5>
            <small class="text-muted">Theo dõi chỉ số hiệu suất KPI chuỗi rạp, doanh thu vé, F&amp;B quầy POS, in nhiệt 80mm &amp; tỷ lệ lấp đầy</small>
        </div>

        <!-- Cinema Filter Dropdown -->
        <form method="get" asp-action="Dashboard" class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="min-width: 280px;">
                <span class="input-group-text bg-light fw-semibold text-muted">
                    <i class="bi bi-buildings text-warning me-1"></i>Chi nhánh:
                </span>
                <select name="cinemaId" class="form-select fw-semibold" onchange="this.form.submit()">
                    <option value="">🏢 Tất cả cụm rạp trong hệ thống</option>
                    @foreach (var c in cinemas)
                    {
                        <!option value="@c.CinemaId" @(selectedCinemaId == c.CinemaId ? "selected" : "")>
                            @c.Name (@c.City)
                        </!option>
                    }
                </select>
            </div>
            @if (selectedCinemaId.HasValue)
            {
                <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm" title="Bỏ lọc">
                    <i class="bi bi-x-circle"></i>
                </a>
            }
        </form>
    </div>
</div>

<!-- 4 Core Executive KPI Cards (Theo Yêu Cầu Hãng Rạp) -->
<div class="row g-3 mb-4">
    <!-- 1. Doanh thu Vé Phim -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100 p-3 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Doanh Thu Vé Phim</span>
                <div class="bg-primary-subtle text-primary p-2 rounded-3">
                    <i class="bi bi-ticket-perforated-fill fs-5"></i>
                </div>
            </div>
            <div class="fs-4 fw-black text-primary mb-1">@todayTicketRevenue.ToString("N0") đ</div>
            <div class="small text-muted d-flex justify-content-between align-items-center">
                <span>Đặt vé hôm nay:</span>
                <span class="fw-bold text-dark">@ViewBag.TodayBookings đơn</span>
            </div>
        </div>
    </div>

    <!-- 2. Doanh thu Bắp Nước F&B (Bao gồm POS Upsell) -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100 p-3 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Bắp Nước F&amp;B (POS Upsell)</span>
                <div class="bg-warning-subtle text-warning p-2 rounded-3">
                    <i class="bi bi-cup-straw fs-5"></i>
                </div>
            </div>
            <div class="fs-4 fw-black text-warning mb-1">@todayFnBRevenue.ToString("N0") đ</div>
            <div class="small text-muted d-flex justify-content-between align-items-center">
                <span>Đóng góp F&amp;B:</span>
                <span class="badge bg-warning-subtle text-dark border">
                    @(todayRevenue > 0 ? Math.Round(todayFnBRevenue / todayRevenue * 100, 1) : 0)% tổng thu
                </span>
            </div>
        </div>
    </div>

    <!-- 3. Tổng số vé đã in nhiệt 80mm -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100 p-3 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Vé In Nhiệt 80mm (Quầy POS)</span>
                <div class="bg-success-subtle text-success p-2 rounded-3">
                    <i class="bi bi-printer-fill fs-5"></i>
                </div>
            </div>
            <div class="fs-4 fw-black text-success mb-1">@printedTickets <small class="fs-6 text-muted">vé</small></div>
            <div class="small text-muted d-flex justify-content-between align-items-center">
                <span>Trạng thái:</span>
                <span class="badge bg-success-subtle text-success">Đã in vé vật lý</span>
            </div>
        </div>
    </div>

    <!-- 4. Tỷ lệ lấp đầy phòng chiếu (%) -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100 p-3 border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Tỷ Lệ Lấp Đầy Phòng Chiếu</span>
                <div class="bg-info-subtle text-info p-2 rounded-3">
                    <i class="bi bi-pie-chart-fill fs-5"></i>
                </div>
            </div>
            <div class="fs-4 fw-black text-info mb-1">@occupancyRate%</div>
            <div class="progress mt-2" style="height: 6px;">
                <div class="progress-bar bg-info progress-bar-striped progress-bar-animated" role="progressbar" style="width: @Math.Min(100, occupancyRate)%"></div>
            </div>
        </div>
    </div>
</div>

<!-- Secondary Infrastructure Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card stat-card bg-primary text-white shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <i class="bi bi-film fs-2 opacity-75"></i>
                <div class="fs-3 fw-bold mt-1">@ViewBag.TotalMovies</div>
                <div class="small opacity-75">Tổng phim</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card stat-card bg-success text-white shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <i class="bi bi-play-circle fs-2 opacity-75"></i>
                <div class="fs-3 fw-bold mt-1">@ViewBag.NowShowing</div>
                <div class="small opacity-75">Đang chiếu</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card stat-card bg-dark text-white shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <i class="bi bi-buildings fs-2 text-warning opacity-75"></i>
                <div class="fs-3 fw-bold mt-1">@ViewBag.TotalCinemas</div>
                <div class="small opacity-75">Cụm rạp chi nhánh</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card stat-card text-white shadow-sm h-100" style="background:#475569;">
            <div class="card-body p-3 text-center">
                <i class="bi bi-building fs-2 opacity-75"></i>
                <div class="fs-3 fw-bold mt-1">@ViewBag.TotalRooms</div>
                <div class="small opacity-75">Phòng chiếu</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card stat-card bg-warning text-dark shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <i class="bi bi-calendar-event fs-2 opacity-75"></i>
                <div class="fs-3 fw-bold mt-1">@ViewBag.TotalShowtimes</div>
                <div class="small opacity-75">Suất chiếu tới</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <a asp-action="Reports" asp-route-cinemaId="@selectedCinemaId" class="text-decoration-none">
            <div class="card stat-card bg-danger text-white shadow-sm h-100 hover-shadow">
                <div class="card-body p-3 text-center">
                    <i class="bi bi-cash-stack fs-2 opacity-75"></i>
                    <div class="fs-4 fw-bold mt-1">@todayRevenue.ToString("N0")đ</div>
                    <div class="small opacity-75">Tổng thu hôm nay <i class="bi bi-arrow-right-short"></i></div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Quick Action Shortcuts -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center justify-content-between h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-success-subtle text-success rounded-3 fs-3">
                    <i class="bi bi-shop"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Cổng Quầy Vé POS 80mm</h6>
                    <small class="text-muted">Bán vé tại quầy &amp; đổi vé online</small>
                </div>
            </div>
            <a asp-controller="Counter" asp-action="Index" class="btn btn-success btn-sm px-3 fw-semibold">
                Mở POS
            </a>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center justify-content-between h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-info-subtle text-info rounded-3 fs-3">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Báo Cáo Phân Tích Doanh Thu</h6>
                    <small class="text-muted">Phân tích theo ngày, phim, combo F&amp;B</small>
                </div>
            </div>
            <a asp-controller="Admin" asp-action="Reports" asp-route-cinemaId="@selectedCinemaId" class="btn btn-primary btn-sm px-3 fw-semibold">
                Xem Báo Cáo
            </a>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center justify-content-between h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-primary-subtle text-primary rounded-3 fs-3">
                    <i class="bi bi-envelope-paper"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Hàng Đợi Email Outbox</h6>
                    <small class="text-muted">Transactional Outbox Pattern (CLO1)</small>
                </div>
            </div>
            <a asp-controller="Admin" asp-action="Outbox" class="btn btn-outline-primary btn-sm px-3 fw-semibold">
                Xem Outbox
            </a>
        </div>
    </div>
</div>

<!-- Recent Movies Table -->
<div class="table-container shadow-sm border-0 rounded-4 bg-white p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-film me-2 text-warning"></i>Phim mới thêm gần đây</h5>
        <div class="d-flex gap-2">
            <a asp-controller="Showtime" asp-action="Create" class="btn btn-outline-primary btn-sm fw-semibold">
                <i class="bi bi-calendar-plus me-1"></i>Lên lịch chiếu
            </a>
            <a asp-controller="Movie" asp-action="Create" class="btn btn-warning btn-sm fw-bold">
                <i class="bi bi-plus-lg me-1"></i>Thêm phim mới
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase fw-semibold text-secondary">
                <tr>
                    <th>Tên phim</th>
                    <th>Thể loại</th>
                    <th>Định dạng</th>
                    <th>Trạng thái</th>
                    <th>Đánh giá</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movie in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(movie.PosterUrl))
                                {
                                    <img src="@movie.PosterUrl" class="rounded object-fit-cover" style="width: 32px; height: 46px;" alt="@movie.Title" />
                                }
                                <div>
                                    <div class="fw-semibold text-dark">@movie.Title</div>
                                    <small class="text-muted">@movie.Director | @movie.Duration phút</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-secondary-subtle text-secondary border">@(movie.Genre?.Name ?? "–")</span></td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">
                                @(movie.Format ?? "2D")
                            </span>
                        </td>
                        <td>
                            @switch (movie.Status)
                            {
                                case MovieStatus.NowShowing:
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">Đang chiếu</span>
                                    break;
                                case MovieStatus.ComingSoon:
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 rounded-pill">Sắp chiếu</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary px-2 py-1 rounded-pill">Kết thúc</span>
                                    break;
                            }
                        </td>
                        <td>
                            @if (movie.Rating > 0)
                            {
                                <span class="text-warning fw-bold"><i class="bi bi-star-fill me-1"></i>@movie.Rating</span>
                            }
                            else { <span class="text-muted">–</span> }
                        </td>
                        <td class="text-end">
                            <a asp-controller="Movie" asp-action="Edit" asp-route-id="@movie.MovieId" class="btn btn-sm btn-outline-primary py-1 px-2.5">
                                <i class="bi bi-pencil-square me-1"></i>Sửa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <p class="text-muted text-center py-4 mb-0">Chưa có phim nào trong hệ thống.</p>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
        <a asp-controller="Movie" asp-action="Index" class="btn btn-outline-primary btn-sm fw-semibold">
            Xem tất cả phim <i class="bi bi-arrow-right ms-1"></i>
        </a>
        <a asp-controller="Admin" asp-action="Bookings" class="btn btn-outline-secondary btn-sm fw-semibold">
            Xem danh sách đặt vé <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</div>
