# ==============================================================================
# CINEMANAGEMENT - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Cloudflare R2 Object Storage Credentials
# Tạo Bucket tại Cloudflare Dashboard > R2 > Create bucket
CLOUDFLARE_R2_URL=https://<your-account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=cinemanagement-media
CLOUDFLARE_R2_ACCESS_KEY=<your-cloudflare-r2-access-key-id>
CLOUDFLARE_R2_SECRET_KEY=<your-cloudflare-r2-secret-access-key>
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<your-r2-hash>.r2.dev
STORAGE_FORCE_PATH_STYLE=false

# 2. MariaDB Database Credentials
MARIADB_ROOT_PASSWORD=cinema_super_secret_root_2026!
MARIADB_DATABASE=cinemanagement_db
MARIADB_USER=cinema_user
MARIADB_PASSWORD=cinema_secure_password_2026!

# 3. Domain & SSL (Cloudflare Origin CA)
DOMAIN_NAME=cinemanagement.vn
